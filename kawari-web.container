# Quadlet unit for ArchonEngine ControlPanel. The installer writes this for you with your own
# paths filled in:
#
#     ./install-service.sh
#
# To place it by hand, copy to ~/.config/containers/systemd/kawari-web.container,
# replace %h with your home directory if it is not the right one, then:
#
#     loginctl enable-linger $USER        # survive logout and start at boot
#     systemctl --user daemon-reload
#     systemctl --user start kawari-web
[Unit]
Description=ArchonEngine ControlPanel
After=network-online.target podman.socket
Wants=network-online.target

[Container]
Image=localhost/kawari-web
ContainerName=kawari-web
PublishPort=7301:7301
# Maps your host uid to the same uid inside the container, so the mounted data
# directory is writable. Without it rootless podman maps to a subuid and the
# app cannot write to /data.
UserNS=keep-id
# The advertised LAN address is not reachable from inside the container; podman
# exposes the host under this name instead.
AddHost=host.containers.internal:host-gateway
Volume=%h/.kawari:/data:z
Volume=%t/podman/podman.sock:/run/podman.sock
Environment=PODMAN_SOCKET=/run/podman.sock
# Podman runs on the host, so bind mounts this app creates must be host paths.
Environment=KAWARI_HOST_DATA_DIR=%h/.kawari
# On SELinux hosts a confined container cannot reach the podman socket, which
# surfaces as PermissionError [Errno 13]. Harmless where SELinux is absent.
SecurityLabelDisable=true

[Service]
# systemd's equivalent of --restart unless-stopped: brought back whenever it
# exits, and `systemctl --user stop` keeps it stopped.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
